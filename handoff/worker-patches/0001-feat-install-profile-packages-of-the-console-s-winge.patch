diff --git a/internal/models/winget.go b/internal/models/winget.go
new file mode 100644
index 0000000..6fcb4ba
--- /dev/null
+++ b/internal/models/winget.go
@@ -0,0 +1,19 @@
+package models
+
+import (
+	"context"
+
+	"github.com/open-uem/ent/softwarepackage"
+)
+
+// LibraryPackageSource is the source, in the software package catalog, of the packages
+// uploaded to the console's private winget repository (Deploy > Software library)
+const LibraryPackageSource = "openuem"
+
+// IsLibraryPackage reports if a package id is one of the console's winget repository's
+// packages. They're installed from that repository instead of winget's community one.
+func (m *Model) IsLibraryPackage(packageID string) (bool, error) {
+	return m.Client.SoftwarePackage.Query().
+		Where(softwarepackage.PackageID(packageID), softwarepackage.Source(LibraryPackageSource)).
+		Exist(context.Background())
+}
diff --git a/internal/models/winget_test.go b/internal/models/winget_test.go
new file mode 100644
index 0000000..4b81847
--- /dev/null
+++ b/internal/models/winget_test.go
@@ -0,0 +1,34 @@
+package models
+
+import (
+	"context"
+	"testing"
+
+	"github.com/open-uem/ent/enttest"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	_ "github.com/mattn/go-sqlite3"
+)
+
+func TestIsLibraryPackage(t *testing.T) {
+	ctx := context.Background()
+	client := enttest.Open(t, "sqlite3", "file:winget?mode=memory&_fk=1")
+	defer client.Close()
+	m := Model{Client: client}
+
+	client.SoftwarePackage.Create().SetPackageID("Example.Community").SetName("Example").SetSource("winget").ExecX(ctx)
+	client.SoftwarePackage.Create().SetPackageID("ExampleCorp.Tool").SetName("Example Tool").SetSource(LibraryPackageSource).ExecX(ctx)
+
+	isLibrary, err := m.IsLibraryPackage("ExampleCorp.Tool")
+	require.NoError(t, err)
+	assert.True(t, isLibrary)
+
+	isLibrary, err = m.IsLibraryPackage("Example.Community")
+	require.NoError(t, err)
+	assert.False(t, isLibrary)
+
+	isLibrary, err = m.IsLibraryPackage("Unknown.Package")
+	require.NoError(t, err)
+	assert.False(t, isLibrary)
+}
